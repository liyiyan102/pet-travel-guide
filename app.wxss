/* 全局样式 - 对齐带爪旅行视觉稿 */
/* 品牌色 #00B86B，深色 #1A1D1F，页面底色 #F7F7F8 */

page {
  background-color: #F7F7F8;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  color: #1A1D1F;
}

/* ==================== 色彩变量 ==================== */
/* --brand: #00B86B   主绿 */
/* --brand-soft: #E8F8F0  浅绿背景 */
/* --orange: #FF7A1A  橙色 */
/* --orange-soft: #FFF3EA 浅橙 */
/* --blue: #3B82F6   蓝色 */
/* --blue-soft: #EFF6FF  浅蓝 */
/* --pink: #EC4899   粉色 */
/* --pink-soft: #FDF2F8  浅粉 */
/* --text-1: #1A1D1F 主文字 */
/* --text-2: #6E7681 次文字 */
/* --text-3: #A8B0B8 弱文字 */
/* --line: #F0F0F2   分割线 */

/* ==================== 容器 ==================== */
.container {
  padding: 0;
  min-height: 100vh;
  background: #F7F7F8;
}

/* ==================== 卡片 ==================== */
.card {
  background: #fff;
  border-radius: 40rpx;
  border: 1rpx solid #F0F0F2;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* ==================== 按钮 ==================== */
.btn-primary {
  background: #1A1D1F;
  color: #fff;
  border: none;
  border-radius: 28rpx;
  padding: 34rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  letter-spacing: 0.4rpx;
}
.btn-primary::after { border: none; }

.btn-green {
  background: #00B86B;
  color: #fff;
  border: none;
  border-radius: 28rpx;
  padding: 34rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-green::after { border: none; }

.btn-secondary {
  background: #fff;
  color: #1A1D1F;
  border: 2rpx solid #F0F0F2;
  border-radius: 28rpx;
  padding: 32rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.btn-secondary::after { border: none; }

.btn-ghost {
  background: rgba(255,255,255,0.12);
  color: #fff;
  border: 2rpx solid rgba(255,255,255,0.2);
  border-radius: 100rpx;
  padding: 20rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-ghost::after { border: none; }

/* ==================== 文字 ==================== */
.h1 {
  font-size: 68rpx;
  font-weight: 800;
  color: #1A1D1F;
  letter-spacing: -1.6rpx;
  line-height: 1.1;
}

.h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1D1F;
  letter-spacing: -0.6rpx;
}

.h3 {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D1F;
}

.title-lg { font-size: 40rpx; font-weight: 700; color: #1A1D1F; }
.title-md { font-size: 34rpx; font-weight: 600; color: #1A1D1F; }
.title-sm { font-size: 28rpx; font-weight: 500; color: #6E7681; }

.sub {
  font-size: 28rpx;
  color: #6E7681;
  line-height: 1.5;
}

.cap {
  font-size: 24rpx;
  color: #A8B0B8;
}

.text-primary { color: #00B86B; }
.text-brand   { color: #00B86B; }
.text-orange  { color: #FF7A1A; }
.text-blue    { color: #3B82F6; }
.text-pink    { color: #EC4899; }
.text-gray    { color: #A8B0B8; font-size: 24rpx; }
.text-2       { color: #6E7681; }

/* ==================== 胶囊标签 ==================== */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.pill-g  { background: #E8F8F0; color: #00B86B; }
.pill-o  { background: #FFF3EA; color: #FF7A1A; }
.pill-b  { background: #EFF6FF; color: #3B82F6; }
.pill-p  { background: #FDF2F8; color: #EC4899; }
.pill-k  { background: #F4F4F6; color: #6E7681; }

/* 兼容旧标签类名 */
.tag { display: inline-block; padding: 6rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; margin-right: 12rpx; }
.tag-blue   { background: #E8F8F0; color: #00B86B; }
.tag-green  { background: #E8F8F0; color: #00B86B; }
.tag-orange { background: #FFF3EA; color: #FF7A1A; }
.tag-red    { background: #FFF2F0; color: #ff4d4f; }

/* ==================== 搜索框 ==================== */
.search-bar-card {
  background: #fff;
  border-radius: 32rpx;
  border: 2rpx solid #F0F0F2;
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.search-bar-card input,
.search-bar-card .search-placeholder {
  border: none;
  background: none;
  font-size: 32rpx;
  flex: 1;
  outline: none;
  color: #1A1D1F;
}
.search-bar-card .search-placeholder { color: #A8B0B8; }

/* ==================== Banner ==================== */
.banner-dark {
  background: #0A0A0C;
  border-radius: 48rpx;
  padding: 56rpx 48rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.banner-dark .glow {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,184,107,0.4), transparent 70%);
}

.banner-dark .banner-title {
  font-size: 48rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  letter-spacing: -1rpx;
  position: relative;
  z-index: 1;
}

.banner-dark .banner-sub {
  font-size: 28rpx;
  opacity: 0.6;
  line-height: 1.5;
  position: relative;
  z-index: 1;
}

.banner-cta {
  margin-top: 40rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255,255,255,0.1);
  padding: 20rpx 36rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
}

/* ==================== 区块标题 ==================== */
.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 64rpx 0 32rpx;
}

.section-title .more {
  font-size: 26rpx;
  color: #A8B0B8;
  font-weight: 500;
}

/* ==================== 列表行 ==================== */
.row-card {
  display: flex;
  gap: 28rpx;
  padding: 28rpx;
  border-radius: 40rpx;
  border: 2rpx solid #F0F0F2;
  background: #fff;
  margin-bottom: 24rpx;
}

.row-icon {
  width: 152rpx;
  height: 152rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.row-body .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1D1F;
  margin-bottom: 6rpx;
}

.row-body .addr {
  font-size: 24rpx;
  color: #A8B0B8;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

/* ==================== AI悬浮按钮 ==================== */
.ai-fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(25rpx + constant(safe-area-inset-bottom));
  bottom: calc(25rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #00CC77 0%, #00A85E 100%);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-shadow: 0 16rpx 40rpx rgba(0,184,107,0.35);
  z-index: 999;
  overflow: hidden;
}

.ai-fab-icon {
  width: 40rpx;
  height: 40rpx;
}

.ai-fab-text {
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

/* ==================== Tab Bar ==================== */
/* 原生tabbar通过app.json控制，这里放页面底部留白 */
.tab-safe { height: 176rpx; }

/* ==================== 分割线 ==================== */
.divider { height: 2rpx; background: #F0F0F2; margin: 0; }

/* ==================== Flex工具类 ==================== */
.flex          { display: flex; }
.flex-column   { flex-direction: column; }
.flex-center   { display: flex; align-items: center; justify-content: center; }
.flex-between  { display: flex; align-items: center; justify-content: space-between; }
.flex-wrap     { flex-wrap: wrap; }
.flex-1        { flex: 1; }

/* ==================== 间距工具类 ==================== */
.mt-8  { margin-top: 16rpx; }
.mt-10 { margin-top: 20rpx; }
.mt-20 { margin-top: 40rpx; }
.mt-30 { margin-top: 60rpx; }
.mb-8  { margin-bottom: 16rpx; }
.mb-10 { margin-bottom: 20rpx; }
.mb-20 { margin-bottom: 40rpx; }
.mb-30 { margin-bottom: 60rpx; }
.p-20  { padding: 40rpx; }
.p-30  { padding: 60rpx; }
.px-24 { padding-left: 48rpx; padding-right: 48rpx; }

/* ==================== 安全区域 ==================== */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #A8B0B8;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state text {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

/* ==================== 加载状态 ==================== */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #A8B0B8;
  font-size: 28rpx;
}
