# ============================================
# Pet Travel Agent 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# 服务配置
PORT=3000
NODE_ENV=production

# 智谱AI API密钥（必填）
ZHIPU_API_KEY=your_zhipu_api_key_here

# 高德地图 Web 服务 Key（POI/地理编码）
AMAP_KEY=your_amap_key_here

# 数据写接口管理员密钥（未配置则禁用写操作）
ADMIN_KEY=

# 上传目录
UPLOAD_DIR=./uploads

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 会话超时时间（分钟）
SESSION_TIMEOUT=60

# 最大会话数
MAX_SESSIONS=1000
