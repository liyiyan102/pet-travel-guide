/* 聊天页面样式 */
page {
  height: 100%;
  background-color: #f5f7fa;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ============ 头部 ============ */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #27AE60 0%, #1E8449 100%);
  color: #fff;
}

.avatar-wrapper {
  position: relative;
  margin-right: 20rpx;
}

.agent-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.5);
}

.online-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 16rpx;
  height: 16rpx;
  background: #2ECC71;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.header-info {
  display: flex;
  flex-direction: column;
}

.agent-name {
  font-size: 34rpx;
  font-weight: 600;
}

.agent-status {
  font-size: 24rpx;
  opacity: 0.85;
}

/* ============ 消息列表 ============ */
.message-list {
  flex: 1;
  padding: 20rpx 30rpx;
  overflow: hidden;
}

.time-divider {
  text-align: center;
  margin: 20rpx 0;
}

.time-text {
  font-size: 22rpx;
  color: #999;
  background: rgba(0,0,0,0.04);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.message-row {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.message-row-user {
  justify-content: flex-end;
}

.message-row-agent {
  justify-content: flex-start;
}

/* 头像 */
.user-avatar, .agent-avatar-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-row-user .user-avatar {
  margin-left: 16rpx;
}

.message-row-agent .agent-avatar-small {
  margin-right: 16rpx;
}

/* 气泡 */
.bubble {
  max-width: 75%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  position: relative;
  word-break: break-all;
}

.bubble-user {
  background: linear-gradient(135deg, #27AE60 0%, #1E8449 100%);
  color: #fff;
  border-top-right-radius: 6rpx;
}

.bubble-agent {
  background: #fff;
  color: #333;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.message-text {
  font-size: 30rpx;
  line-height: 1.6;
}

.agent-text {
  color: #444;
}

/* 图片消息 */
.image-wrapper {
  margin-top: 12rpx;
}

.message-image {
  max-width: 400rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

/* 打字动画 */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 10rpx 0;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  background: #ccc;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* 分析卡片 */
.analysis-card, .itinerary-card {
  margin-top: 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #e9ecef;
}

.card-header {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e9ecef;
}

.itinerary-header {
  background: linear-gradient(135deg, #E8F8F5 0%, #D5F4E6 100%);
}

.card-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.card-body {
  padding: 20rpx 24rpx;
}

.analysis-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.analysis-label {
  font-size: 26rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.analysis-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.analysis-value.safe { color: #27AE60; }
.analysis-value.danger { color: #E74C3C; }

.confidence-badge {
  font-size: 22rpx;
  background: #27AE60;
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 12rpx;
}

.itinerary-days {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.day-tag {
  background: linear-gradient(135deg, #27AE60 0%, #1E8449 100%);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.card-footer {
  padding: 14rpx 24rpx;
  text-align: right;
  font-size: 24rpx;
  color: #27AE60;
  background: #f8f9fa;
  border-top: 1rpx solid #e9ecef;
}

/* 建议标签 */
.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.suggestion-chip {
  background: #E8F8F5;
  color: #27AE60;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  border: 1rpx solid #C8E6C9;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  background: linear-gradient(135deg, #27AE60 0%, #1E8449 100%);
  color: #fff;
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

/* ============ 底部占位 ============ */
.bottom-spacer {
  height: 280rpx;
}

/* ============ 输入区域 ============ */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.feature-entries {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 20rpx;
  background: #fafbfc;
  border-bottom: 1rpx solid #f0f0f0;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
}

.feature-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.feature-text {
  font-size: 22rpx;
  color: #666;
}

.input-wrapper {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.message-input {
  flex: 1;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  border: none;
}

.preview-images {
  display: flex;
  gap: 12rpx;
  margin-left: 16rpx;
}

.preview-item {
  position: relative;
  width: 100rpx;
  height: 100rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.remove-img {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: #FF4D4F;
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}

.input-actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  gap: 12rpx;
}

.icon-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus-icon {
  font-size: 44rpx;
  font-weight: 300;
  color: #6E7681;
  line-height: 1;
}

.send-btn {
  background: #ccc;
  color: #fff;
  padding: 0 32rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  font-size: 28rpx;
}

.send-btn.active {
  background: linear-gradient(135deg, #27AE60 0%, #1E8449 100%);
}
