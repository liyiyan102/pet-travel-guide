<!--pages/mytrips/mytrips.wxml-->
<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <text class="title-lg">我的攻略</text>
    <text class="subtitle">管理和查看您的旅行攻略</text>
  </view>

  <!-- 筛选标签 -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <view class="filter-list">
      <view 
        wx:for="{{filters}}" 
        wx:key="id"
        class="filter-item {{currentFilter === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onFilterChange"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- 攻略列表 -->
  <scroll-view 
    class="trip-list" 
    scroll-y 
    style="height: calc(100vh - 400rpx);"
    bindscrolltolower="loadMore"
  >
    <!-- 攻略卡片 -->
    <view 
      wx:for="{{filteredTrips}}" 
      wx:key="itinerary_id"
      class="trip-card card"
      data-trip="{{item}}"
      bindtap="onTripTap"
    >
      <!-- 卡片头部 -->
      <view class="card-header">
        <view class="trip-title-area">
          <text class="trip-title">{{item.title}}</text>
          <view class="trip-days">
            <image src="/images/calendar-sm.png" mode="aspectFit"></image>
            <text>{{item.days}}天行程</text>
          </view>
        </view>
        <view class="card-menu" catchtap="showMenu" data-id="{{item.itinerary_id}}">
          <image src="/images/more.png" mode="aspectFit"></image>
        </view>
      </view>
      
      <!-- 目的地信息 -->
      <view class="trip-destination">
        <image src="/images/location-pin.png" mode="aspectFit"></image>
        <text>{{item.destination}}</text>
        <text class="trip-date">{{item.created_at}}</text>
      </view>
      
      <!-- 行程预览 -->
      <view class="trip-preview">
        <view 
          wx:for="{{item.days_data}}" 
          wx:key="day"
          wx:for-item="day"
          wx:for-index="dayIndex"
          class="day-item"
          wx:if="{{dayIndex < 3}}"
        >
          <view class="day-label">Day{{day.day}}</view>
          <view class="day-spots">
            <text 
              wx:for="{{day.spots}}" 
              wx:key="name"
              wx:for-item="spot"
              wx:if="{{index < 4}}"
              class="spot-name"
            >{{spot.name}}</text>
            <text wx:if="{{day.spots.length > 4}}" class="spot-more">+{{day.spots.length - 4}}</text>
          </view>
        </view>
        <view wx:if="{{item.days_data.length > 3}}" class="more-days">
          还有{{item.days_data.length - 3}}天行程...
        </view>
      </view>
      
      <!-- 底部操作栏 -->
      <view class="card-footer">
        <view class="footer-left">
          <view class="pet-info">
            <image src="/images/pet-small.png" mode="aspectFit"></image>
            <text>{{item.input_params.pets.length || 1}}只宠物</text>
          </view>
          <view class="spot-count">
            <text>共{{getTotalSpots(item)}}个地点</text>
          </view>
        </view>
        <view class="footer-right">
          <button class="btn-edit" catchtap="onEditTrip" data-id="{{item.itinerary_id}}">
            <image src="/images/edit.png" mode="aspectFit"></image>
            <text>编辑</text>
          </button>
          <button class="btn-share" catchtap="onShareTrip" data-trip="{{item}}">
            <image src="/images/share.png" mode="aspectFit"></image>
            <text>分享</text>
          </button>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{filteredTrips.length === 0 && !loading}}" class="empty-state">
      <image src="/images/empty-trip.png" mode="aspectFit"></image>
      <text class="empty-title">还没有攻略哦</text>
      <text class="empty-desc">快去AI生成一个专属宠物友好攻略吧！</text>
      <button class="btn-primary" bindtap="goToGenerate">立即生成</button>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loading}}" class="loading-more">
      <text>加载中...</text>
    </view>
    
    <!-- 没有更多了 -->
    <view wx:if="{{!loading && filteredTrips.length >= 5}}" class="no-more">
      <text>— 已经到底啦 —</text>
    </view>
  </scroll-view>

  <!-- 操作菜单弹窗 -->
  <view wx:if="{{showMenuPopup}}" class="menu-popup-mask" bindtap="hideMenu">
    <view class="menu-popup" catchtap="">
      <view class="menu-item" catchtap="onEditTrip" data-id="{{currentMenuId}}">
        <image src="/images/edit.png" mode="aspectFit"></image>
        <text>编辑攻略</text>
      </view>
      <view class="menu-item" catchtap="onDuplicateTrip" data-id="{{currentMenuId}}">
        <image src="/images/copy.png" mode="aspectFit"></image>
        <text>复制攻略</text>
      </view>
      <view class="menu-item danger" catchtap="onDeleteTrip" data-id="{{currentMenuId}}">
        <image src="/images/delete.png" mode="aspectFit"></image>
        <text>删除攻略</text>
      </view>
    </view>
  </view>

  <!-- 删除确认弹窗 -->
  <view wx:if="{{showDeleteConfirm}}" class="confirm-popup-mask" bindtap="cancelDelete">
    <view class="confirm-popup" catchtap="">
      <view class="confirm-title">确认删除</view>
      <view class="confirm-content">删除后无法恢复，确定要删除这个攻略吗？</view>
      <view class="confirm-actions">
        <button class="btn-cancel" bindtap="cancelDelete">取消</button>
        <button class="btn-confirm-delete" bindtap="confirmDelete">确认删除</button>
      </view>
    </view>
  </view>
</view>
