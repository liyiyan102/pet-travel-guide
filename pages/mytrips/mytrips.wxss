/* pages/mytrips/mytrips.wxss */

.container {
  padding: 0;
  background: #f5f7fa;
}

/* 页面头部 */
.page-header {
  padding: 32rpx 24rpx 24rpx;
  background: #fff;
}

.page-header .title-lg {
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

/* 筛选标签 */
.filter-scroll {
  background: #fff;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-list {
  display: flex;
  padding: 20rpx 24rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f7fa;
  white-space: nowrap;
}

.filter-item.active {
  background: linear-gradient(135deg, #27AE60 0%, #1E8449 100%);
  color: #fff;
}

/* 攻略列表 */
.trip-list {
  padding: 20rpx 24rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 攻略卡片 */
.trip-card {
  padding: 0;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 24rpx 0;
}

.trip-title-area {
  flex: 1;
}

.trip-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.trip-days {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.trip-days image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

.trip-days text {
  font-size: 24rpx;
  color: #999;
}

.card-menu {
  padding: 8rpx;
}

.card-menu image {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.6;
}

/* 目的地信息 */
.trip-destination {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f8fafc;
}

.trip-destination image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.trip-destination text {
  font-size: 26rpx;
  color: #666;
}

.trip-date {
  margin-left: auto !important;
  font-size: 22rpx !important;
  color: #bbb !important;
}

/* 行程预览 */
.trip-preview {
  padding: 20rpx 24rpx;
}

.day-item {
  margin-bottom: 16rpx;
}

.day-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #27AE60;
  margin-bottom: 8rpx;
}

.day-spots {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.spot-name {
  padding: 6rpx 14rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #666;
}

.spot-more {
  padding: 6rpx 14rpx;
  background: #e6f4ff;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #27AE60;
}

.more-days {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 0;
}

/* 底部操作栏 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fafbfc;
}

.footer-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pet-info, .spot-count {
  display: flex;
  align-items: center;
}

.pet-info image {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

.pet-info text, .spot-count text {
  font-size: 22rpx;
  color: #999;
}

.footer-right {
  display: flex;
  gap: 16rpx;
}

.btn-edit, .btn-share {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: transparent;
  border: none;
  font-size: 24rpx;
  line-height: inherit;
  margin: 0;
}

.btn-edit::after, .btn-share::after {
  border: none;
}

.btn-edit {
  color: #27AE60;
}

.btn-share {
  color: #52c41a;
}

.btn-edit image, .btn-share image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-state image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

/* 加载状态 */
.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* 菜单弹窗 */
.menu-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-popup {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  min-width: 280rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx;
  font-size: 30rpx;
  color: #333;
}

.menu-item image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
}

.menu-item.danger {
  color: #ff4d4f;
}

/* 删除确认弹窗 */
.confirm-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-popup {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  width: 560rpx;
}

.confirm-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.confirm-content {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.confirm-actions {
  display: flex;
  gap: 20rpx;
}

.btn-cancel, .btn-confirm-delete {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  text-align: center;
  margin: 0;
}

.btn-cancel {
  background: #f5f7fa;
  color: #666;
}

.btn-confirm-delete {
  background: #ff4d4f;
  color: #fff;
}

.btn-cancel::after, .btn-confirm-delete::after {
  border: none;
}
