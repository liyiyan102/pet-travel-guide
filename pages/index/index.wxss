/* 首页样式 */

.home-scroll {
  height: 100vh;
  background: #F7F7F8;
}

/* 标题区 */
.home-header {
  padding: 24rpx 0 0;
  background: #F7F7F8;
}

.hero-banner {
  width: 100%;
  display: block;
}

.home-content {
  padding: 16rpx 48rpx 0;
}

/* 分类金刚区 */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.cat-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 搜索框图标 */
.icon-svg {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.cat-name {
  font-size: 24rpx;
  color: #6E7681;
  font-weight: 500;
}

/* 城市卡片横滑 */
.city-scroll {
  margin: 0 -48rpx;
  padding: 0 48rpx;
}

.city-list {
  display: flex;
  gap: 24rpx;
  padding-right: 48rpx;
  width: max-content;
}

.city-card {
  width: 280rpx;
  height: 360rpx;
  border-radius: 32rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
}

.city-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.05) 40%, rgba(0,0,0,0.72) 100%);
}

.city-paw {
  position: absolute;
  top: 32rpx;
  right: 28rpx;
  font-size: 36rpx;
  opacity: 0.7;
  z-index: 1;
}

.city-info {
  position: absolute;
  bottom: 28rpx;
  left: 28rpx;
  right: 28rpx;
  color: #fff;
  z-index: 1;
}

.city-name {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
}

.city-stat {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 6rpx;
}
